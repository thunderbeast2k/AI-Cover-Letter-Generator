# Git
.git
.gitignore

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
backend/venv/
backend/.pytest_cache/
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep

# Node.js
frontend/node_modules/
frontend/.npm/
frontend/dist/

# Environment and Secrets (prevent baking secrets into images)
**/.env
**/.env.local
**/.env.*.local

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Documentation
docs/
*.md
!README.md
